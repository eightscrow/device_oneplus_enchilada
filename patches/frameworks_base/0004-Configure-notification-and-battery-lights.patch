+package com.android.internal.util.voltage;
+
+import android.content.ContentResolver;
+import android.provider.Settings;
+
+/** Shared, per-user notification and battery LED preferences. @hide */
+public final class LedSettings {
+    public static final String COLOR = "notification_light_color";
+    public static final String BRIGHTNESS = "notification_light_brightness";
+    public static final String PATTERN = "notification_light_pattern";
+    public static final String LOCK_SCREEN = "notification_light_on_lock_screen";
+    public static final String BATTERY_ENABLED = "battery_light_enabled";
+    public static final String BATTERY_LOW = "battery_light_low_color";
+    public static final String BATTERY_CHARGING = "battery_light_charging_color";
+    public static final String BATTERY_FULL = "battery_light_full_color";
+    public static final String BATTERY_BRIGHTNESS = "battery_light_brightness";
+    public static final String BATTERY_LOW_MODE = "battery_light_low_mode";
+    public static final String BATTERY_SCREEN_OFF = "battery_light_screen_off";
+    public static final String BATTERY_DND = "battery_light_dnd_off";
+
+    public static final String[] KEYS = { COLOR, BRIGHTNESS, PATTERN, LOCK_SCREEN,
+            BATTERY_ENABLED, BATTERY_LOW, BATTERY_CHARGING, BATTERY_FULL,
+            BATTERY_BRIGHTNESS, BATTERY_LOW_MODE, BATTERY_SCREEN_OFF, BATTERY_DND };
+
+    private LedSettings() {}
+
+    public static int read(ContentResolver resolver, String key, int userId) {
+        return sanitize(key, Settings.Secure.getIntForUser(
+                resolver, key, defaultValue(key), userId));
+    }
+
+    public static int defaultValue(String key) {
+        if (BRIGHTNESS.equals(key) || BATTERY_BRIGHTNESS.equals(key)) return 100;
+        if (BATTERY_ENABLED.equals(key)) return 1;
+        return 0;
+    }
+
+    public static int sanitize(String key, int value) {
+        if (COLOR.equals(key) || BATTERY_LOW.equals(key) || BATTERY_CHARGING.equals(key)
+                || BATTERY_FULL.equals(key)) {
+            // Zero means the ROM/app default. Black must not silently disable a light.
+            return (value & 0x00ffffff) == 0 ? 0 : value | 0xff000000;
+        }
+        if (BRIGHTNESS.equals(key) || BATTERY_BRIGHTNESS.equals(key)) {
+            return value == 25 || value == 50 || value == 75 || value == 100 ? value : 100;
+        }
+        if (PATTERN.equals(key) || BATTERY_LOW_MODE.equals(key)) {
+            return value >= 0 && value <= 3 ? value : 0;
+        }
+        return value == 0 || value == 1 ? value : defaultValue(key);
+    }
+
+    public static int color(int configured, int fallback) {
+        return configured == 0 ? fallback : configured;
+    }
+
+    public static int notificationColor(int configured, int appColor, int channelColor,
+            boolean userLocked) {
+        return userLocked && (channelColor & 0x00ffffff) != 0
+                ? channelColor : color(configured, appColor);
+    }
+
+    public static int brightness(int color, int percent) {
+        // Preserve the HAL's alpha semantics and scale RGB only once.
+        int alpha = color >>> 24;
+        if (alpha == 0) alpha = 255;
+        int red = component((color >> 16) & 255, alpha, percent);
+        int green = component((color >> 8) & 255, alpha, percent);
+        int blue = component(color & 255, alpha, percent);
+        return 0xff000000 | (red << 16) | (green << 8) | blue;
+    }
+
+    private static int component(int value, int alpha, int percent) {
+        return value == 0 ? 0 : Math.max(1, value * alpha * percent / 25500);
+    }
+
+    public static int onMillis(int pattern, int fallback) {
+        return pattern == 0 ? fallback : 500;
+    }
+
+    public static int offMillis(int pattern, int fallback) {
+        switch (pattern) {
+            case 1: return 500;
+            case 2: return 2000;
+            case 3: return 5000;
+            default: return fallback;
+        }
+    }
+}
