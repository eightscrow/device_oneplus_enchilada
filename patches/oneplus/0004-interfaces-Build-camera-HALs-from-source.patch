From 9fb9b7875bef677ddc2486c92077c27044d8f361 Mon Sep 17 00:00:00 2001
From: Terminator-J <terminator_j@hotbutteredmonkey.com>
Date: Sat, 1 Mar 2025 13:47:46 -0800
Subject: [PATCH] interfaces: Build camera HALs from source [2/3]

Drop vendor.oneplus.hardware.camera@1.0 and vendor.oneplus.hardware.CameraMDMHIDL@1.0 blobs,
build from source in hardware/oneplus instead.

Needed for being able to allow properly unlocking hardware capabilities via injecting client package name in cmaeraservice.

This is a squash of the following commits:

* interfaces: Import CameraMDMHIDL HAL

  Change-Id: I8350eb3a01cff5f28e546c382b88635768ea92d6
  Signed-off-by: firebird11 <hbgassel@gmail.com>

* interfaces: Move CameraMDMHIDL to hardware

  Signed-off-by: firebird11 <hbgassel@gmail.com>

* interfaces: Import camera HAL

  Signed-off-by: firebird11 <hbgassel@gmail.com>
_____

[Terminator-J]:
Update install locations, multilib settings, and don't generate java to avoid conflicts with prebuilt blobs

Co-authored by: Pierre-Hugues Husson <phh@phh.me>
Co-authored by: Hikari-no-Tenshi <kyryljan.serhij@gmail.com>
Co-authored by: firebird11 <hbgassel@gmail.com>
---
 .../oneplus/hardware/CameraMDMHIDL/1.0/Android.bp | 15 +++++++++++++++
 .../CameraMDMHIDL/1.0/IOnePlusCameraMDM.hal       |  7 +++++++
 interfaces/oneplus/hardware/camera/1.0/Android.bp | 15 +++++++++++++++
 .../camera/1.0/IOnePlusCameraProvider.hal         | 13 +++++++++++++
 4 files changed, 50 insertions(+)
 create mode 100644 interfaces/oneplus/hardware/CameraMDMHIDL/1.0/Android.bp
 create mode 100644 interfaces/oneplus/hardware/CameraMDMHIDL/1.0/IOnePlusCameraMDM.hal
 create mode 100644 interfaces/oneplus/hardware/camera/1.0/Android.bp
 create mode 100644 interfaces/oneplus/hardware/camera/1.0/IOnePlusCameraProvider.hal

diff --git a/interfaces/oneplus/hardware/CameraMDMHIDL/1.0/Android.bp b/interfaces/oneplus/hardware/CameraMDMHIDL/1.0/Android.bp
new file mode 100644
index 0000000..4752b3a
--- /dev/null
+++ b/interfaces/oneplus/hardware/CameraMDMHIDL/1.0/Android.bp
@@ -0,0 +1,15 @@
+// This file is autogenerated by hidl-gen -Landroidbp.
+
+hidl_interface {
+    name: "vendor.oneplus.hardware.CameraMDMHIDL@1.0",
+    root: "vendor.oneplus",
+    compile_multilib: "both",
+    system_ext_specific: true,
+    srcs: [
+        "IOnePlusCameraMDM.hal",
+    ],
+    interfaces: [
+        "android.hidl.base@1.0",
+    ],
+    gen_java: false,
+}
diff --git a/interfaces/oneplus/hardware/CameraMDMHIDL/1.0/IOnePlusCameraMDM.hal b/interfaces/oneplus/hardware/CameraMDMHIDL/1.0/IOnePlusCameraMDM.hal
new file mode 100644
index 0000000..8023c31
--- /dev/null
+++ b/interfaces/oneplus/hardware/CameraMDMHIDL/1.0/IOnePlusCameraMDM.hal
@@ -0,0 +1,7 @@
+package vendor.oneplus.hardware.CameraMDMHIDL@1.0;
+
+interface IOnePlusCameraMDM {
+    getJankMsg() generates (string a);
+    setJankMsg(string a, uint32_t b, uint32_t c);
+    setCameraId(uint32_t a, uint32_t b, uint32_t c);
+};
diff --git a/interfaces/oneplus/hardware/camera/1.0/Android.bp b/interfaces/oneplus/hardware/camera/1.0/Android.bp
new file mode 100644
index 0000000..ade4cad
--- /dev/null
+++ b/interfaces/oneplus/hardware/camera/1.0/Android.bp
@@ -0,0 +1,15 @@
+// This file is autogenerated by hidl-gen -Landroidbp.
+
+hidl_interface {
+    name: "vendor.oneplus.hardware.camera@1.0",
+    root: "vendor.oneplus",
+    compile_multilib: "both",
+    system_ext_specific: true,
+    srcs: [
+        "IOnePlusCameraProvider.hal",
+    ],
+    interfaces: [
+        "android.hidl.base@1.0",
+    ],
+    gen_java: false,
+}
diff --git a/interfaces/oneplus/hardware/camera/1.0/IOnePlusCameraProvider.hal b/interfaces/oneplus/hardware/camera/1.0/IOnePlusCameraProvider.hal
new file mode 100644
index 0000000..28767b2
--- /dev/null
+++ b/interfaces/oneplus/hardware/camera/1.0/IOnePlusCameraProvider.hal
@@ -0,0 +1,13 @@
+package vendor.oneplus.hardware.camera@1.0;
+
+interface IOnePlusCameraProvider {
+    setCameraId(int32_t name) generates (bool status);
+    setPackageName(string name) generates (bool status);
+    getPackageName() generates (string cameraDeviceNames);
+    file_access(string path) generates (bool status);
+    file_delete(string path) generates (bool status);
+    file_open(string path) generates (int32_t fd);
+    file_write(int32_t fd, vec<int8_t> buffer, int32_t size) generates (bool status2);
+    file_read(int32_t fd, int32_t size) generates (bool status, vec<int8_t> buffer, int32_t size);
+    file_close(int32_t fd) generates (bool status);
+};
-- 
