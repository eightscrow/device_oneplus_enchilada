@@ -9,7 +9,19 @@
 import com.android.settingslib.widget.SettingsBasePreferenceFragment
 
 class ButtonSettingsFragment : SettingsBasePreferenceFragment() {
+    private lateinit var touchVibration: TouchVibrationPreference
     override fun onCreatePreferences(savedInstanceState: Bundle?, rootKey: String?) {
         setPreferencesFromResource(R.xml.button_panel, rootKey)
+        touchVibration = TouchVibrationPreference(requireContext(),
+            requireNotNull(findPreference("touch_vibration_intensity")))
+    }
+    override fun onStart() {
+        super.onStart()
+        touchVibration.start()
+    }
+
+    override fun onStop() {
+        touchVibration.stop()
+        super.onStop()
     }
 }
