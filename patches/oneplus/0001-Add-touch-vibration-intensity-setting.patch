+<?xml version="1.0" encoding="utf-8"?>
+<!-- SPDX-License-Identifier: Apache-2.0 -->
+<resources>
+    <bool name="config_touchVibrationIntensity">false</bool>
+    <string name="touch_vibration_intensity_title">Touch vibration intensity</string>
+    <string name="touch_vibration_save_error">Could not save touch vibration intensity</string>
+    <string-array name="touch_vibration_intensity_entries">
+        <item>Off</item>
+        <item>Low</item>
+        <item>Standard</item>
+    </string-array>
+    <string-array name="touch_vibration_intensity_values" translatable="false">
+        <item>0</item>
+        <item>1</item>
+        <item>2</item>
+    </string-array>
+</resources>
