 DisplayError ColorManagerProxy::ColorMgrGetModeInfo(int32_t mode_id, AttrVal *query) {
-  return color_intf_->ColorIntfGetModeInfo(&pp_features_, 0, mode_id, query);
+  DisplayError error = color_intf_->ColorIntfGetModeInfo(&pp_features_, display_id_, mode_id, query);
+  if (error != kErrorNone || !query || query->empty()) {
+    return error;
+  }
+
+  // Legacy color libraries describe the rendering intent through PictureQuality.
+  // Normalize their missing/-1 intent before HWC and SDM validate the attributes.
+  std::string picture_quality;
+  std::string *render_intent = nullptr;
+  for (auto &attribute : *query) {
+    if (attribute.first == kPictureQualityAttribute) {
+      picture_quality = attribute.second;
+    } else if (attribute.first == kRenderIntentAttribute) {
+      render_intent = &attribute.second;
+    }
+  }
+  if ((!render_intent || *render_intent == "-1") &&
+      (picture_quality == kStandard || picture_quality == kEnhanced)) {
+    const std::string intent = picture_quality == kStandard ? "0" : "1";
+    if (render_intent) {
+      *render_intent = intent;
+    } else {
+      query->emplace_back(kRenderIntentAttribute, intent);
+    }
+  }
+  return error;
 }
 
