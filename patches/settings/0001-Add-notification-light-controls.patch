+package com.android.settings.notification;
+
+import android.app.ActivityManager;
+import android.app.AlarmManager;
+import android.app.Notification;
+import android.app.NotificationChannel;
+import android.app.NotificationManager;
+import android.app.PendingIntent;
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+import android.os.PowerManager;
+import android.os.SystemClock;
+import android.os.UserHandle;
+import android.provider.Settings;
+import android.widget.Toast;
+
+import com.android.settings.R;
+
+/** A real, silent test notification follows the normal LED and DND rules. */
+public class NotificationLightPreview extends BroadcastReceiver {
+    private static final String CHANNEL = "notification_light_preview";
+    private static final String TAG = "notification_light_preview";
+    private static final int ID = 1;
+
+    private static PendingIntent pendingIntent(Context context) {
+        return PendingIntent.getBroadcast(context, 0,
+                new Intent(context, NotificationLightPreview.class),
+                PendingIntent.FLAG_UPDATE_CURRENT | PendingIntent.FLAG_IMMUTABLE);
+    }
+
+    public static void schedule(Context context) {
+        cancel(context);
+        AlarmManager alarm = context.getSystemService(AlarmManager.class);
+        if (!alarm.canScheduleExactAlarms()) {
+            Toast.makeText(context, R.string.led_test_unavailable, Toast.LENGTH_LONG).show();
+            return;
+        }
+        alarm.setExact(AlarmManager.ELAPSED_REALTIME_WAKEUP,
+                SystemClock.elapsedRealtime() + 5000, pendingIntent(context));
+        Toast.makeText(context, R.string.led_test_instructions, Toast.LENGTH_LONG).show();
+    }
+
+    public static void cancel(Context context) {
+        context.getSystemService(AlarmManager.class).cancel(pendingIntent(context));
+        context.getSystemService(NotificationManager.class).cancel(TAG, ID);
+    }
+
+    @Override
+    public void onReceive(Context context, Intent intent) {
+        if (ActivityManager.getCurrentUser() != UserHandle.myUserId()
+                || context.getSystemService(PowerManager.class).isInteractive()
+                || Settings.System.getInt(context.getContentResolver(),
+                        Settings.System.NOTIFICATION_LIGHT_PULSE, 0) == 0) return;
+        NotificationManager manager = context.getSystemService(NotificationManager.class);
+        NotificationChannel channel = new NotificationChannel(CHANNEL,
+                context.getText(R.string.led_test_title), NotificationManager.IMPORTANCE_DEFAULT);
+        channel.enableLights(true);
+        channel.setSound(null, null);
+        channel.enableVibration(false);
+        manager.createNotificationChannel(channel);
+        manager.notify(TAG, ID, new Notification.Builder(context, CHANNEL)
+                .setSmallIcon(R.drawable.ic_lightbulb_outline_24)
+                .setContentTitle(context.getText(R.string.led_test_title))
+                .setContentText(context.getText(R.string.led_test_notification))
+                .setTimeoutAfter(20000)
+                .setAutoCancel(true)
+                .setLocalOnly(true)
+                .build());
+    }
+}
