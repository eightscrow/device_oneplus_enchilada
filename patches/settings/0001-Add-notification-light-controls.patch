+++ b/res/values/notification_light.xml
@@ -0,0 +1,82 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- Copyright (C) 2026 eightscrow; SPDX-License-Identifier: Apache-2.0 -->
+<resources>
+    <string name="led_settings_title">Notification light</string>
+    <string name="led_entry_on">On. Colors, blinking and charging light</string>
+    <string name="led_entry_off">Off. Colors, blinking and charging light</string>
+    <string name="led_notifications_enabled">Use notification light</string>
+    <string name="led_help">The light follows notification categories and Do Not Disturb. Unlocking clears the current light. Enable the light in the categories you want to use. Default keeps app colors; a selected category color overrides the default notification color.</string>
+    <string name="led_default_color">Default notification color</string>
