+
+package com.android.settings.notification.app;
+
+import android.app.NotificationChannel;
+import android.content.Context;
+
+import androidx.preference.Preference;
+
+import com.android.internal.util.voltage.LedSettings;
+import com.android.settings.RestrictedListPreference;
+import com.android.settings.notification.NotificationBackend;
+import com.android.settings.notification.NotificationLightSettings;
+
+public class LightColorPreferenceController extends LightsPreferenceController {
+    public LightColorPreferenceController(Context context, NotificationBackend backend) {
+        super(context, backend);
+    }
+
+    @Override
+    public String getPreferenceKey() {
+        return "light_color";
+    }
+
+    @Override
+    public void updateState(Preference preference) {
+        if (mChannel == null) return;
+        RestrictedListPreference list = (RestrictedListPreference) preference;
+        list.setDisabledByAdmin(mAdmin);
+        list.setEnabled(mAdmin == null && mChannel.shouldShowLights());
+        NotificationLightSettings.configureColorPreference(list,
+                (mChannel.getUserLockedFields() & NotificationChannel.USER_LOCKED_LIGHTS) != 0
+                        ? mChannel.getLightColor() : 0);
+    }
+
+    @Override
+    public boolean onPreferenceChange(Preference preference, Object newValue) {
+        if (mChannel == null || mAdmin != null || !mChannel.shouldShowLights()) return false;
+        mChannel.setLightColor(LedSettings.sanitize(LedSettings.COLOR,
+                Integer.parseInt((String) newValue)));
+        mChannel.lockFields(NotificationChannel.USER_LOCKED_LIGHTS);
+        saveChannel();
+        updateState(preference);
+        return true;
+    }
+}
