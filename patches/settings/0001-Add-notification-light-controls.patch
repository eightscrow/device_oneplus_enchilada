+
+package com.android.settings.notification;
+
+import android.app.settings.SettingsEnums;
+import android.content.Context;
+import android.database.ContentObserver;
+import android.os.Bundle;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.UserHandle;
+import android.provider.Settings;
+
+import androidx.preference.ListPreference;
+import androidx.preference.Preference;
+import androidx.preference.TwoStatePreference;
+
+import com.android.internal.util.voltage.LedSettings;
+import com.android.settings.R;
+import com.android.settings.dashboard.DashboardFragment;
+import com.android.settings.search.BaseSearchIndexProvider;
+import com.android.settingslib.search.SearchIndexable;
+
+@SearchIndexable
+public class NotificationLightSettings extends DashboardFragment {
+    private final ContentObserver mObserver = new ContentObserver(new Handler(Looper.getMainLooper())) {
+        @Override
+        public void onChange(boolean selfChange) {
+            refresh();
+        }
+    };
+
+    @Override
+    public int getMetricsCategory() {
+        return SettingsEnums.CONFIGURE_NOTIFICATION;
+    }
+
+    @Override
+    protected String getLogTag() {
+        return "NotificationLight";
+    }
+
+    @Override
+    protected int getPreferenceScreenResId() {
+        return R.xml.notification_light_settings;
+    }
+
+    @Override
+    public void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        for (String key : LedSettings.KEYS) {
+            Preference preference = findPreference(key);
+            preference.setPersistent(false);
+            preference.setOnPreferenceChangeListener((pref, value) -> {
+                int number = value instanceof Boolean ? ((Boolean) value ? 1 : 0)
+                        : Integer.parseInt((String) value);
+                return Settings.Secure.putInt(getContext().getContentResolver(), key,
+                        LedSettings.sanitize(key, number));
+            });
+        }
+        findPreference("led_test").setOnPreferenceClickListener(pref -> {
+            NotificationLightPreview.schedule(getContext());
+            return true;
+        });
+        findPreference("led_cancel_test").setOnPreferenceClickListener(pref -> {
+            NotificationLightPreview.cancel(getContext());
+            return true;
+        });
+    }
+
+    @Override
+    public void onResume() {
+        super.onResume();
+        for (String key : LedSettings.KEYS) {
+            getContext().getContentResolver().registerContentObserver(
+                    Settings.Secure.getUriFor(key), false, mObserver);
+        }
+        getContext().getContentResolver().registerContentObserver(Settings.System.getUriFor(
+                Settings.System.NOTIFICATION_LIGHT_PULSE), false, mObserver);
+        refresh();
+    }
+
+    @Override
+    public void onPause() {
+        getContext().getContentResolver().unregisterContentObserver(mObserver);
+        super.onPause();
+    }
+
+    private void refresh() {
+        if (getContext() == null || getPreferenceScreen() == null) return;
+        boolean notifications = Settings.System.getInt(getContext().getContentResolver(),
+                Settings.System.NOTIFICATION_LIGHT_PULSE, 0) != 0;
+        boolean battery = LedSettings.read(getContext().getContentResolver(),
+                LedSettings.BATTERY_ENABLED, UserHandle.myUserId()) == 1;
+        for (String key : LedSettings.KEYS) {
+            Preference preference = findPreference(key);
+            int value = LedSettings.read(getContext().getContentResolver(), key,
+                    UserHandle.myUserId());
+            if (preference instanceof ListPreference) {
+                ListPreference list = (ListPreference) preference;
+                if (key.endsWith("color")) configureColorPreference(list, value);
+                else list.setValue(Integer.toString(value));
+            } else if (preference instanceof TwoStatePreference) {
+                ((TwoStatePreference) preference).setChecked(value == 1);
+            }
+            preference.setEnabled(LedSettings.BATTERY_ENABLED.equals(key)
+                    || (key.startsWith("battery_light_") ? battery : notifications));
+        }
+        findPreference("led_test").setEnabled(notifications);
+    }
+
+    public static void configureColorPreference(ListPreference preference, int color) {
+        preference.setEntries(R.array.led_color_names);
+        preference.setEntryValues(R.array.led_color_values);
+        String value = Integer.toString(color);
+        if (preference.findIndexOfValue(value) < 0) {
+            CharSequence[] entries = preference.getEntries();
+            CharSequence[] values = preference.getEntryValues();
+            CharSequence[] extendedEntries = java.util.Arrays.copyOf(entries, entries.length + 1);
+            CharSequence[] extendedValues = java.util.Arrays.copyOf(values, values.length + 1);
+            extendedEntries[entries.length] = String.format("#%06X", color & 0x00ffffff);
+            extendedValues[values.length] = value;
+            preference.setEntries(extendedEntries);
+            preference.setEntryValues(extendedValues);
+        }
+        preference.setValue(value);
+        preference.setSummaryProvider(ListPreference.SimpleSummaryProvider.getInstance());
+    }
+
+    public static final BaseSearchIndexProvider SEARCH_INDEX_DATA_PROVIDER =
+            new BaseSearchIndexProvider(R.xml.notification_light_settings) {
+                @Override
+                protected boolean isPageSearchEnabled(Context context) {
+                    return context.getResources().getBoolean(
+                            com.android.internal.R.bool.config_intrusiveNotificationLed);
+                }
+            };
+}
