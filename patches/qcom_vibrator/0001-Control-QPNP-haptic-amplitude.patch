diff --git a/aidl/VibratorOL/QpnpAmplitude.h b/aidl/VibratorOL/QpnpAmplitude.h
new file mode 100644
--- /dev/null
+++ b/aidl/VibratorOL/QpnpAmplitude.h
@@ -0,0 +1,63 @@
+// SPDX-License-Identifier: Apache-2.0
+
+#pragma once
+
+#include <algorithm>
+#include <cerrno>
+#include <cmath>
+#include <functional>
+#include <mutex>
+#include <utility>
+
+class QpnpAmplitude {
+public:
+    using Writer = std::function<int(const char*, int)>;
+    static constexpr int kStepMv = 116;
+    static constexpr int kDefaultMv = 2088;
+
+    explicit QpnpAmplitude(Writer writer) : mWrite(std::move(writer)) {}
+
+    int initialize() { return off(); }
+
+    int setAmplitude(float amplitude) {
+        if (!std::isfinite(amplitude) || amplitude <= 0 || amplitude > 1) return -EINVAL;
+        std::lock_guard<std::mutex> lock(mMutex);
+        const int steps = std::max(1, static_cast<int>(std::lround(
+                amplitude * (kDefaultMv / kStepMv))));
+        const int millivolts = steps * kStepMv;
+        const int result = mWrite("vmax_mv", millivolts);
+        mAmplitudeValid = result == 0;
+        if (mAmplitudeValid) mMillivolts = millivolts;
+        return result;
+    }
+
+    int on(int timeoutMs) {
+        if (timeoutMs <= 0 || timeoutMs > 15000) return -EINVAL;
+        std::lock_guard<std::mutex> lock(mMutex);
+        if (!mAmplitudeValid) return -EIO;
+        int result = mWrite("activate", 0);
+        if (result == 0) result = mWrite("vmax_mv", mMillivolts);
+        if (result == 0) result = mWrite("state", 1);
+        if (result == 0) result = mWrite("duration", timeoutMs);
+        if (result == 0) result = mWrite("activate", 1);
+        if (result != 0) {
+            mWrite("activate", 0);
+            mAmplitudeValid = false;
+        }
+        return result;
+    }
+
+    int off() {
+        std::lock_guard<std::mutex> lock(mMutex);
+        mMillivolts = kDefaultMv;
+        int result = mWrite("activate", 0);
+        mAmplitudeValid = result == 0;
+        return result;
+    }
+
+private:
+    Writer mWrite;
+    std::mutex mMutex;
+    int mMillivolts = kDefaultMv;
+    bool mAmplitudeValid = false;
+};
